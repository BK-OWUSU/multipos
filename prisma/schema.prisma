  CASH
  MOMO
  CARD
  SPLIT
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

//MODEL TO GENERATE CUSTOM_IDS
model Sequence {
  id         String   @id @default(cuid())

  businessId String
  type       String

  currentNo  Int      @default(0)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([businessId, type])
  @@index([businessId])
}


